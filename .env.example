# ==============================================================================
# BRIGHTPATH CRM — LOCAL ENVIRONMENT VARIABLES TEMPLATE
# ==============================================================================
# INSTRUCTIONS:
# 1. Duplicate this file and rename the copy to '.env' in the project root.
# 2. Replace the placeholder values with your real Supabase project credentials.
# 3. Retrieve these values from: Supabase Dashboard -> Project Settings -> API.
# 4. NEVER commit the real '.env' file to Git (it is ignored by .gitignore).
# ==============================================================================

# Supabase Project URL (e.g., https://xyzcompany.supabase.co)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anonymous Public Client Key (safe for public frontend code)
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-public-client-key
